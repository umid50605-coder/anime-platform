# Copy this file to backend/.env for local development
# (pydantic-settings loads backend/.env automatically - see backend/app/core/config).

# --- General ---
ENVIRONMENT=development
# Only ever set this true for local troubleshooting. When true, unhandled
# exceptions return a raw traceback (source/locals) to the HTTP client
# instead of the safe {"detail": "Internal server error"} response, and
# bypass the app's own exception-logging handler entirely.
DEBUG=false

# --- Database ---
# SQLite by default so the foundation runs with zero external infra.
# For production, point this at PostgreSQL instead, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/anime_platform
DATABASE_URL=sqlite:///./anime_platform.db

# --- Security / Auth ---
# CHANGE THIS in any real deployment - generate with e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=CHANGE_ME_IN_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# JSON array syntax (pydantic-settings parses list-typed env vars as JSON).
# The Vite dev server's default port (5173) is the built-in default.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO

# --- Integrations ---
# Only "mock" is implemented today - see app/integrations/*.
ANIME_PROVIDER=mock
VIDEO_PROVIDER=mock

# --- Frontend (Vite) ---
# Vite only reads VITE_-prefixed vars from its OWN .env file at frontend/.env,
# not from this root file. Copy the line below into frontend/.env as well
# (see frontend/.env.example).
VITE_API_BASE_URL=http://127.0.0.1:8000
